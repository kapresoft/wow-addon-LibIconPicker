<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">

    <Script file="HelpTip.lua"/>
    <Script file="HelpTour.lua"/>
    <Script file="TourList.lua"/>

    <!-- Help tip view; LibIconPicker_HelpTour sets its text and target per step.
         Counter shows the step position on multi-step tours. Arrow points
         down from below the tip; ArrowUp points up from above it and is
         shown instead when the tip flips below its target. Both are
         anchored in Lua's PlaceAt, on the side nearer the target's screen
         edge, so the tip opens away from that edge. -->
    <Frame name="LibIconPicker_HelpTipTemplate" inherits="GlowBoxTemplate"
           mixin="LibIconPicker_HelpTipMixin"
           enableMouse="true" hidden="true" virtual="true" clampedToScreen="true">
        <Size x="220" y="60"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlightLeft" justifyV="TOP">
                    <Size x="188" y="0"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="16" y="-16"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Counter" inherits="GameFontDisableSmall" hidden="true">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-10" y="6"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="CloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="6" y="6"/>
                </Anchors>
            </Button>
            <Frame parentKey="Arrow" inherits="GlowBoxArrowTemplate"/>
            <Frame parentKey="ArrowUp" hidden="true">
                <Size x="53" y="21"/>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Arrow" inherits="HelpPlateArrowUp">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="BORDER">
                        <Texture parentKey="Glow" inherits="HelpPlateArrow-GlowUp" alphaMode="ADD" alpha="0.5">
                            <Anchors>
                                <Anchor point="BOTTOM"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>

</Ui>
